# ---------------------------------------------------------------------------
# ForgeDesk configuration. Copy to .env and fill in real values.
# Never commit .env. Placeholders only in this file.
# ---------------------------------------------------------------------------

# --- Rime (primary and only judged TTS path) --------------------------------
RIME_API_KEY=your_rime_api_key_here
# Model/speaker/lang MUST be a combination present in the live catalog
# (https://users.rime.ai/data/voices/all-v2.json). `python -m scripts.preflight` checks this.
RIME_MODEL_ID=coda
RIME_SPEAKER=astra
RIME_LANG=en
# Regional endpoints: users.rime.ai / users-west.rime.ai / users-east.rime.ai
RIME_HTTP_BASE=https://users.rime.ai
# ws3 JSON websocket (audio chunks + word timestamps). East: wss://users-east-ws.rime.ai
RIME_WS_BASE=wss://users-ws.rime.ai
# Output sample rate requested from Rime (Coda native = 24000, Mist native = 22050)
RIME_SAMPLE_RATE=24000
# ws3 (recommended: word timestamps for the heard-ledger) | http (L16 streaming fallback)
RIME_TRANSPORT=ws3

# --- Speech provider selection ------------------------------------------------
# rime (default, judged path) | fake (offline logic tests only; never used in judged flow)
TTS_PROVIDER=rime

# --- Speech recognition -------------------------------------------------------
# deepgram | browser (Chrome Web Speech API, zero-key) | auto (deepgram if key present else browser)
STT_PROVIDER=auto
DEEPGRAM_API_KEY=your_deepgram_api_key_here
DEEPGRAM_MODEL=nova-3

# --- Language model -----------------------------------------------------------
# openai (any OpenAI-compatible chat completions endpoint) | rules (built-in zero-key rule agent) | auto
LLM_PROVIDER=auto
LLM_API_KEY=your_llm_api_key_here
# e.g. https://api.openai.com/v1 or https://api.groq.com/openai/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- Stress / evaluation knobs --------------------------------------------------
# Artificial delay injected into every booking-system tool call (ms). 0 = none.
TOOL_DELAY_MS=0
# Speak a short "still checking" filler if a tool runs longer than this (ms).
FILLER_AFTER_MS=1200
# Minimum continuous user speech before it counts as a barge-in (ms).
BARGE_IN_MIN_MS=180
# Which signals may interrupt the agent: vad (mic energy) | stt (recogniser interim text) | either
BARGE_IN_MODE=either

# --- Server -----------------------------------------------------------------------
HOST=127.0.0.1
PORT=8080
EVIDENCE_DIR=evidence
